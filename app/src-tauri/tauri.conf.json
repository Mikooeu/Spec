{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spec",
  "version": "0.14.4",
  "identifier": "com.spec.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Spec",
        "width": 1280,
        "height": 800,
        "minWidth": 1280,
        "minHeight": 800,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Spec",
    "shortDescription": "Recommandations de pick pendant la sélection des champions",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "template": "installer/installer.nsi",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false
      }
    },
    "copyright": "© 2026 Spec"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdCOUY5MTg0MjNBQTRDRjcKUldUM1RLb2poSkdmZXdtOEQ4MkNSYytTeThWS0tFUmVSOTN4bE9hRHhEZC9jc21ibnVTT3o4MTUK",
      "endpoints": [
        "https://github.com/Mikooeu/Spec/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "Spec"
}
