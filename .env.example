# Copie ce fichier en .env puis remplace la valeur ci-dessous par ta Personal API Key.
# Le fichier .env est exclu de Git : ta clé ne sera jamais publiée.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Routage Riot (EUW pour commencer ; KR et NA viendront à l'étape 5)
RIOT_PLATFORM=euw1
RIOT_REGION=europe

# Emplacement de la base de données locale
DB_PATH=data/draft.duckdb

# Profondeur d'historique au premier passage (jours)
DAYS_BACK=14

# Fréquence de rafraîchissement du ladder Master+ (heures)
LADDER_REFRESH_HOURS=6
